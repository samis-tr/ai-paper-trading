# Copy to .env (never commit .env). No bank, broker or payment credentials belong anywhere in this project.
# Market data (owner creates the account; free tier first)
EODHD_API_TOKEN=
# Telegram (outbound only). Leave empty -> messages go to data/outbox.log (dry run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Long random string; required for the web emergency-stop button
DASHBOARD_OWNER_TOKEN=
